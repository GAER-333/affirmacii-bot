# Образец настроек для озвучки (tools\voice.ps1).
# Скопируйте этот файл под именем .env и впишите свои значения.
# Файл .env не попадает в git — ключ останется только на вашем компьютере.

# Ключ API: elevenlabs.io → профиль (слева внизу) → API Keys → Create
ELEVENLABS_API_KEY=

# ID голоса: My Voices → три точки у голоса → Copy voice ID
VOICE_ID=

# Можно задать отдельный голос для каждого времени суток (необязательно):
# VOICE_ID_MORNING=
# VOICE_ID_DAY=
# VOICE_ID_NIGHT=

# Модель с поддержкой русского языка
ELEVENLABS_MODEL=eleven_multilingual_v2

# Стабильность 0..1: чем выше, тем ровнее и спокойнее интонация
STABILITY=0.6

# Скорость речи 0.7..1.2: для аффирмаций лучше чуть медленнее обычного
SPEED=0.9

# Ключ API Яндекс SpeechKit (tools/yandex-voice.js): AI Studio → «Создать API-ключ»
YANDEX_API_KEY=
